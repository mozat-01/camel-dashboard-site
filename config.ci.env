# ── Treasure Camel 看板 · 配置 ────────────────────────────────
# ❗这个文件含登录凭据，不要提交到 git、不要外发。

# 管理员用户名。2026-10-22 起登录接口需要 username（前端默认值就是 admin）
CAMEL_USERNAME=admin

# ✅ 推荐：填管理员密码，脚本每次跑自动登录换票，不用再管 Cookie 过期
#   登录协议：POST /app/41011/v1/admin/session  {"password": "..."}
#   成功 204 + Set-Cookie: treasure_camel_admin=...（Max-Age=86400 即 24 小时）
#   CI 里用环境变量 CAMEL_PASSWORD 注入（GitHub Secrets），优先级高于本文件
# CAMEL_PASSWORD 由 GitHub Secrets 注入，不写在这里

# 兜底：手填 Cookie（只在没有密码时才需要；填了 CAMEL_PASSWORD 就忽略这项）
#   1. Chrome 打开 https://server-game.letskix.com/app/41011/admin/analytics/ 并登录
#   2. F12 → Network → 随便点一个 analytics 请求 → Headers → Request Headers
#   3. 复制 Cookie: 后面那一整行，粘到下面等号右边（不要带 "Cookie:" 三个字）
# CAMEL_COOKIE 不用（CI 走密码自动登录）

# 统计窗口。END 留空＝自动取「昨天」（沙特日），这样定时跑永远只用完整日
WINDOW_START=2026-09-12
WINDOW_END=

# 逐日留存表的起始日
RETENTION_START=2026-09-15

# 漏斗与 Credits 来源只看最近 N 天
FUNNEL_DAYS=10

# 单次 Spin 结果分布只看最近 N 天
HIT_DAYS=7

# 跨游戏留存对比的起始日（Redshift 侧）
CROSSGAME_START=2026-10-01

# 输出
OUT_HTML=site/index.html
